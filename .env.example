# ══════════════════════════════════════════════════════════════════════════
#  Intelligence Module — Environment Variables
#  Copy to `.env` for local runs. In production these live as:
#    • GitHub Actions → repo Settings → Secrets and variables → Actions
#    • Static host    → only the PUBLIC (anon) values are needed client-side
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────
# URL is safe to expose. The ANON key is safe for the browser (RLS-guarded).
# The SERVICE key is SECRET — used ONLY by the pipeline (GitHub Actions).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...        # public — used by front-end + read paths
SUPABASE_SERVICE_KEY=eyJhbGciOi...     # SECRET — pipeline writes only

# ── Search providers (pipeline) ───────────────────────────────────────────
# Serper is preferred (Google SERP, 2,500 free credits). Tavily is fallback.
SERPER_API_KEY=
TAVILY_API_KEY=

# ── LLM providers (pipeline) — tried in this order, free first ────────────
# Order: GROQ → GEMINI → OPENAI. Claude is intentionally NOT wired in.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Force a specific extractor provider (optional): groq | gemini | openai
LLM_PROVIDER=

# ── Alerting (optional) ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_SCORE_THRESHOLD=12

# ── Tuning knobs (optional; sane defaults in config.py) ───────────────────
DEDUP_SIMILARITY_THRESHOLD=0.85
AUTO_PUBLISH_HIGH_CONFIDENCE=false     # if true, grounded high-confidence cases skip review

# ── Guardrails (optional; keep it light & free-tier safe) ─────────────────
MAX_CANDIDATES_PER_SWEEP=15            # cap LLM/API spend per enforcement run
ARTICLE_MAX_CHARS=5000                 # cap tokens sent to the LLM per article
STORY_RETENTION_DAYS=90               # auto-prune older stories to cap DB size
GROUNDING_ENABLED=true                # verify candidates against official sources
FEW_SHOT_EXAMPLES=6                   # past reviewer decisions fed to the extractor
